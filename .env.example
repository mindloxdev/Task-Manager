# PostgreSQL. On the server, deploy/setup-database.sh fills this in.
DATABASE_URL="postgresql://task_manager:change-me@127.0.0.1:5432/task_manager"
AUTH_SECRET="replace-with-a-32-char-plus-random-secret"
SESSION_TTL_HOURS="12"
CRON_SECRET="replace-with-a-random-secret"
ATTACHMENT_DIR="./storage/attachments"
MAX_UPLOAD_MB="10"
# Email is optional. Leave EMAIL_PROVIDER unset and no email is sent (and none is claimed).
# EMAIL_PROVIDER="resend"
# EMAIL_API_KEY=""
# EMAIL_FROM="MindLox Task Manager <no-reply@example.com>"
APP_URL="http://localhost:3000"

# Server deployment only (deploy/install.sh). The app listens on 127.0.0.1:PORT
# and nginx serves it at https://DOMAIN.
DOMAIN="tasks.mindlox.io"
PORT="4020"
