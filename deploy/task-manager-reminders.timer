# Installed by deploy/install.sh as /etc/systemd/system/task-manager-reminders.timer.
# The sweep is idempotent, so a run missed while the server was off is simply
# caught up at boot (Persistent=true).
[Unit]
Description=Hourly MindLox Task Manager reminder sweep

[Timer]
OnCalendar=hourly
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
